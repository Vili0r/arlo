model CapaEffectiveness {
  id     String @id @default(cuid())
  orgId  String
  capaId String @unique

  effectivenessVerificationSummary String?   @db.Text
  ineffectiveJustification         String?   @db.Text
  dateDue                          DateTime?

  // Approvals
  primaryApproverId   String?
  secondaryApproverId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capa         Capa         @relation(fields: [capaId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id])

  primaryApprover   User? @relation("EffectivenessPrimaryApprover", fields: [primaryApproverId], references: [id])
  secondaryApprover User? @relation("EffectivenessSecondaryApprover", fields: [secondaryApproverId], references: [id])

  attachments Attachment[]

  @@index([orgId])
  @@index([primaryApproverId])
