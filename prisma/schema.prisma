  organization Organization @relation(fields: [orgId], references: [id])

  primaryApprover   User? @relation("PlanningPrimaryApprover", fields: [primaryApproverId], references: [id])
  secondaryApprover User? @relation("PlanningSecondaryApprover", fields: [secondaryApproverId], references: [id])

  attachments Attachment[]

  @@index([orgId])
  @@index([primaryApproverId])
  @@index([secondaryApproverId])
}

model CapaImplementation {
  id     String @id @default(cuid())
  orgId  String
  capaId String @unique

  dateDue                DateTime?
