generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Identity & Multi-Tenancy (Synced from Clerk)
// -------------------------------------------------------------

model User {
  id        String    @id // Clerk User ID (user_...)
  email     String    @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Multi-tenant relations
  memberships                      OrganizationMember[]
  createdComplaints                Complaint[]                  @relation("ComplaintCreator")
  assignedComplaints               Complaint[]                  @relation("ComplaintInvestigator")
  approvedComplaints               Complaint[]                  @relation("ComplaintApprover")
  ownedComplaints                  Complaint[]                  @relation("ComplaintOwner")
  customerCommunications           CustomerCommunication[]
  investigations                   Investigation[]              @relation("InvestigationInvestigator")
  riskReviewedInvestigations       Investigation[]              @relation("RiskReviewCompletedBy")
  investigationSummaryCompletedBy  Investigation[]              @relation("InvestigationSummaryCompletedBy")
  summaryCompletedInvestigations   InvestigationSummary[]       @relation("InvestigationSummaryCompletedBy")
  assignedCustomSections           InvestigationCustomSection[] @relation("CustomSectionAssignedTo")
  completedCustomSections          InvestigationCustomSection[] @relation("CustomSectionCompletedBy")
  noInvestigationDeterminations    Investigation[]              @relation("NoInvestigationDeterminedBy")
  attachments                      Attachment[]
  ownedCapas                       Capa[]                       @relation("CapaOwner")
  primaryApprovedInitiations       CapaInitiation[]             @relation("InitiationPrimaryApprover")
  secondaryApprovedInitiations     CapaInitiation[]             @relation("InitiationSecondaryApprover")
  signedInitiations                CapaInitiation[]             @relation("InitiationSignOff")
  investigatedCapaPhases           CapaInvestigation[]          @relation("InvestigationInvestigator")
  primaryApprovedInvestigations    CapaInvestigation[]          @relation("InvestigationPrimaryApprover")
  secondaryApprovedInvestigations  CapaInvestigation[]          @relation("InvestigationSecondaryApprover")
  primaryApprovedPlannings         CapaPlanning[]               @relation("PlanningPrimaryApprover")
  secondaryApprovedPlannings       CapaPlanning[]               @relation("PlanningSecondaryApprover")
  primaryApprovedImplementations   CapaImplementation[]         @relation("ImplementationPrimaryApprover")
  secondaryApprovedImplementations CapaImplementation[]         @relation("ImplementationSecondaryApprover")
  primaryApprovedEffectivenesses   CapaEffectiveness[]          @relation("EffectivenessPrimaryApprover")
  secondaryApprovedEffectivenesses CapaEffectiveness[]          @relation("EffectivenessSecondaryApprover")
  requestedExtensions              ExtensionRequest[]           @relation("ExtensionRequester")
  primaryApprovedExtensions        ExtensionRequest[]           @relation("ExtensionPrimaryApprover")
  secondaryApprovedExtensions      ExtensionRequest[]           @relation("ExtensionSecondaryApprover")
  ownedVigilanceRecords            VigilanceDecisionTree[]      @relation("VigilanceOwner")
  approvedVigilanceRecords         VigilanceDecisionTree[]      @relation("VigilanceApprover")
  originatedTasks                  ComplaintTask[]              @relation("TaskOriginator")
  assignedTasks                    ComplaintTask[]              @relation("TaskAssignee")
  auditLogs                        AuditLog[]
  recordLocks                      RecordLock[]

  @@index([email])
}

model Organization {
  id        String    @id // Clerk Organization ID (org_...)
  name      String
  slug      String?   @unique
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Multi-tenant relations
  members                       OrganizationMember[]
  complaints                    Complaint[]
  productInformation            ProductInformation[]
  patientInformation            PatientInformation[]
  customerCommunications        CustomerCommunication[]
  sampleManagements             SampleManagement[]
  investigations                Investigation[]
  investigationImdrfCodes       InvestigationIMDRFCode[]
  investigationSectionTemplates InvestigationSectionTemplate[]
  investigationCustomSections   InvestigationCustomSection[]
  vigilanceDecisionTrees        VigilanceDecisionTree[]
  attachments                   Attachment[]
  complaintTasks                ComplaintTask[]
  capas                         Capa[]
  capaInitiations               CapaInitiation[]
  capaInvestigations            CapaInvestigation[]
  capaPlannings                 CapaPlanning[]
  capaImplementations           CapaImplementation[]
  capaEffectivenesses           CapaEffectiveness[]
  extensionRequests             ExtensionRequest[]
  formTemplates                 FormTemplate[]
  auditLogs                     AuditLog[]
  investigationSummaries        InvestigationSummary[]
  recordLocks                   RecordLock[]
  mirs                          MIR[]
  vigilanceQuestionAnswers      VigilanceQuestionAnswer[]
  vigilanceJurisdictionAssessments VigilanceJurisdictionAssessment[]

  @@index([slug])
}

model OrganizationMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String // e.g. "org:admin", "org:qa_manager", "org:complaint_investigator", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// -------------------------------------------------------------
// Dynamic Custom Form Templates (Category 4 Configured Software)
// Stores the blueprint of custom fields as JSONB — no migrations
// needed when an org adds/removes/archives fields.
// -------------------------------------------------------------

model FormTemplate {
  id               String   @id @default(cuid())
  orgId            String
  entityType       String // "Complaint", "Capa", etc.
  version          Int      @default(1)
  schemaDefinition Json // Array<FormFieldDefinition>
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, entityType])
  @@index([orgId])
}

// -------------------------------------------------------------
// Core Quality Records (PMS / ISO 13485 / 21 CFR Part 11)
// -------------------------------------------------------------

enum MIRStatus {
  DRAFT
  IN_REVIEW
  SUBMITTED
  CANCELLED
}

enum MIRReportType {
  INITIAL
  FOLLOW_UP
  COMBINED
  FINAL
  FINAL_NON_REPORTABLE
}

enum MIRClassification {
  SERIOUS_PUBLIC_HEALTH_THREAT
  DEATH
  UNANTICIPATED_DETERIORATION
  ALL_OTHER_REPORTABLE
}

enum ComplaintStatus {
  OPEN
  UNDER_INVESTIGATION
  PENDING_REVIEW
  IN_PROGRESS
  PENDING_RESPONSE
  CLOSED
  REOPENED
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Death {
  YES
  NO
  UNKNOWN
}

enum CommunicationStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum SampleStatus {
  PENDING
  RECEIVED
  UNDER_EVALUATION
  RETURNED
  DISPOSED
  NOT_AVAILABLE
}

enum InvestigationStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  NOT_REQUIRED
  CANCELLED
}

enum VigilanceAssessmentStage {
  INITIAL
  POST_INVESTIGATION
  AD_HOC
}

enum VigilanceStatus {
  PENDING
  REPORTABLE
  NOT_REPORTABLE
  SUBMITTED
  CANCELLED
}

enum VigilanceReportabilityDecision {
  NON_REPORTABLE
  REPORTABLE_30_DAY
  REPORTABLE_15_DAY
  REPORTABLE_5_DAY
  REPORTABLE_OTHER
}

enum VigilanceReportType {
  INITIAL
  FOLLOW_UP
  FINAL
  COMBINED_INITIAL_FINAL
}

model Complaint {
  id                              String          @id @default(cuid())
  orgId                           String // Multi-tenant isolation
  complaintNumber                 String // e.g. CMP-2026-0001
  shortDescription                String // Replaces title
  description                     String
  status                          ComplaintStatus @default(OPEN)
  priority                        Priority // Replaces severity (CRITICAL, HIGH, MEDIUM, LOW)
  awarenessDate                   DateTime // Date manufacturer became aware
  dateReceived                    DateTime // Date logged
  regulatoryReportingReference    String?
  customerName                    String
  customerType                    String
  initialReporterName             String
  initialReporterSurname          String
  email                           String
  address                         String
  country                         String
  telNumber                       String
  countryEventOccurred            String
  region                          String
  death                           Death           @default(NO)
  detailDescriptionNativeLanguage String?
  customerResponseNeeded          Boolean         @default(true)
  finalResponseCompletedOn        DateTime?
  complaintOwnerId                String // Maps to Clerk User ID

  // Legacy / Intact Optional Fields
  deviceModel          String?
  deviceSerialNumber   String?
  lotNumber            String?
  isAdverseEvent       Boolean @default(false)
  investigationSummary String?
  rootCause            String?
  closureRationale     String?

  // Dynamic custom fields (JSONB Template Pattern)
  customData          Json? @default("{}") // Record<fieldHash, value>
  formTemplateVersion Int? // Template version at time of entry

  // Accountability & Separation of Duties (21 CFR Part 11)
  createdById            String
  assignedInvestigatorId String?
  approvedById           String? // Must not equal assignedInvestigatorId

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete (No hard deletes)

  // Multi-tenant & Identity Relations
  organization         Organization @relation(fields: [orgId], references: [id])
  createdBy            User         @relation("ComplaintCreator", fields: [createdById], references: [id])
  assignedInvestigator User?        @relation("ComplaintInvestigator", fields: [assignedInvestigatorId], references: [id])
  approvedBy           User?        @relation("ComplaintApprover", fields: [approvedById], references: [id])
  complaintOwner       User?        @relation("ComplaintOwner", fields: [complaintOwnerId], references: [id])

  // Relational Models (1:N and 1:1)
  productInformation     ProductInformation[]
  patientInformation     PatientInformation[]
  customerCommunications CustomerCommunication[]
  sampleManagement       SampleManagement?
  investigation          Investigation?
  vigilanceDecisionTrees VigilanceDecisionTree[]
  vigilanceQuestionAnswers VigilanceQuestionAnswer[]
  vigilanceJurisdictionAssessments VigilanceJurisdictionAssessment[]
  mirs                   MIR[]
  attachments            Attachment[]
  tasks                  ComplaintTask[]
  auditLogs              AuditLog[]

  @@unique([orgId, complaintNumber])
  @@index([orgId, status])
  @@index([orgId, priority])
  @@index([createdById])
  @@index([complaintOwnerId])
  @@index([assignedInvestigatorId])
}

// -------------------------------------------------------------
// Relational Sub-Models (IMDRF, Patient, Product & Vigilance)
// -------------------------------------------------------------

model ProductInformation {
  id                  String   @id @default(cuid())
  orgId               String // Multi-tenant isolation
  complaintId         String
  occurrence          String?
  materialNumber      String?
  materialDescription String?
  serialNumber        String?
  batchNumber         String?
  udi                 String?
  asReportedCode1     String? // IMDRF Code 1
  asReportedCode2     String? // IMDRF Code 2
  softwareVersion     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization             @relation(fields: [orgId], references: [id])
  complaint    Complaint                @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  imdrfCodes   InvestigationIMDRFCode[]

  @@index([orgId])
  @@index([complaintId])
}

model PatientInformation {
  id                String    @id @default(cuid())
  orgId             String // Multi-tenant isolation
  complaintId       String
  patientImpact     String?
  patientImpactDesc String?
  patientName       String?
  sex               String?
  age               Int?
  eventOccurred     DateTime?
  annexE_Codes      String[]  @default([]) // IMDRF Annex E codes
  annexF_Codes      String[]  @default([]) // IMDRF Annex F codes
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  complaint    Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([complaintId])
}

model CustomerCommunication {
  id                String              @id @default(cuid())
  orgId             String // Multi-tenant isolation
  complaintId       String
  communicationDate DateTime            @default(now())
  status            CommunicationStatus @default(OPEN)
  questionAsked     String?
  customerResponse  String?
  internalNotes     String?
  authorId          String // Clerk User ID
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  complaint    Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])
  attachments  Attachment[]

  @@index([orgId])
  @@index([complaintId])
  @@index([authorId])
}

model SampleManagement {
  id              String       @id @default(cuid())
  orgId           String // Multi-tenant isolation
  complaintId     String       @unique
  sampleAvailable Boolean      @default(false)
  trackingDetails String?
  status          SampleStatus @default(PENDING)
  receivedDate    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  complaint    Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Investigation {
  id             String              @id @default(cuid())
  orgId          String // Multi-tenant isolation
  complaintId    String              @unique
  status         InvestigationStatus @default(NOT_STARTED)
  investigatorId String? // Clerk User ID
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // A. Attachments & Sample Analysis
  attachments                   Attachment[]
  sampleAnalysisAssignedDate    DateTime?
  sampleAnalysisCompleteDate    DateTime?
  sampleAnalysisRequired        Boolean      @default(false)
  sampleAnalysisExemptRationale String?
  decontaminatedAt              DateTime?
  sampleReceivedDate            DateTime?
  quantity                      Int?
  sampleAnalysisResults         String?

  // B. Risk Review Section
  riskReviewRequired        Boolean   @default(false)
  riskReviewExemptRationale String?
  riskReviewCompletedAt     DateTime?
  riskReviewCompletedById   String?
  riskReviewResults         String?

  // C. Investigation Summary (Decoupled)
  investigationSummaryCompletedById String?
  investigationSummaryCompletedAt   DateTime?
  summary                           InvestigationSummary?

  // D. Investigation Determination (FDA 21 CFR 820.198(b) / ISO 13485 8.2.2)
  noInvestigationReason         String?
  noInvestigationDeterminedById String?
  noInvestigationDeterminedAt   DateTime?

  organization                    Organization @relation(fields: [orgId], references: [id])
  complaint                       Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  investigator                    User?        @relation("InvestigationInvestigator", fields: [investigatorId], references: [id])
  riskReviewCompletedBy           User?        @relation("RiskReviewCompletedBy", fields: [riskReviewCompletedById], references: [id])
  investigationSummaryCompletedBy User?        @relation("InvestigationSummaryCompletedBy", fields: [investigationSummaryCompletedById], references: [id])
  noInvestigationDeterminedBy     User?        @relation("NoInvestigationDeterminedBy", fields: [noInvestigationDeterminedById], references: [id])

  customSections InvestigationCustomSection[]

  @@index([orgId])
  @@index([investigatorId])
  @@index([riskReviewCompletedById])
  @@index([investigationSummaryCompletedById])
  @@index([noInvestigationDeterminedById])
}

model InvestigationSummary {
  id                          String    @id @default(cuid())
  orgId                       String
  investigationId             String    @unique
  completedById               String?
  completedAt                 DateTime?
  summary                     String?
  report                      String?
  capaFscaRationale           String?
  capaRequired                Boolean   @default(false)
  capaRef                     String?
  fscaRequired                Boolean   @default(false)
  fscaRef                     String?
  notes                       String?
  reportabilityReviewRequired Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  organization  Organization             @relation(fields: [orgId], references: [id])
  investigation Investigation            @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  completedBy   User?                    @relation("InvestigationSummaryCompletedBy", fields: [completedById], references: [id])
  imdrfCodes    InvestigationIMDRFCode[]

  @@index([orgId])
  @@index([completedById])
}

model VigilanceDecisionTree {
  id              String                   @id @default(cuid())
  orgId           String // Multi-tenant isolation
  complaintId     String
  status          VigilanceStatus          @default(PENDING)
  assessmentStage VigilanceAssessmentStage @default(INITIAL)
  reportable      Boolean                  @default(false)

  // Ownership & Approval (Separation of Duties)
  ownerId    String? // Clerk User ID (The person drafting the assessment)
  approverId String? // Clerk User ID (The person signing off)

  // Reporting Metrics
  targetRegion  String?
  decision      VigilanceReportabilityDecision?
  reportType    VigilanceReportType?
  awarenessDate DateTime?
  dueDate       DateTime?

  // Text & Rationale
  rationale          String?
  cancelledRationale String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  complaint    Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  owner        User?        @relation("VigilanceOwner", fields: [ownerId], references: [id])
  approver     User?        @relation("VigilanceApprover", fields: [approverId], references: [id])
  attachments  Attachment[]

  questionAnswers         VigilanceQuestionAnswer[]
  jurisdictionAssessments VigilanceJurisdictionAssessment[]

  @@index([orgId])
  @@index([complaintId])
  @@index([ownerId])
  @@index([approverId])
}

// -------------------------------------------------------------
// Global Medical Device Vigilance & Reportability Engine Models
// -------------------------------------------------------------

enum CanonicalAnswer {
  YES
  NO
  UNKNOWN
  NOT_APPLICABLE
  NOT_YET_DETERMINED
}

enum FactSourceType {
  USER
  AI_SUGGESTED
  INTEGRATION
  INVESTIGATION_SUMMARY
}

enum FactReviewStateType {
  DRAFT
  SUGGESTED
  APPROVED
  REJECTED
}

model VigilanceQuestionAnswer {
  id              String              @id @default(cuid())
  orgId           String
  complaintId     String
  vigilanceId     String?
  questionId      String              // Stable canonical ID, e.g., CAUSALITY_001
  answer          CanonicalAnswer     @default(NOT_YET_DETERMINED)
  structuredValue String?             // Optional causality or severity value
  rationale       String?             @db.Text
  evidence        Json?               @default("[]") // Array of evidence string identifiers / references
  source          FactSourceType      @default(USER)
  confidence      Float?              // AI extraction confidence (0.0 to 1.0)
  reviewStatus    FactReviewStateType @default(APPROVED)
  answeredById    String?
  answeredAt      DateTime            @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id])
  complaint    Complaint              @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  vigilance    VigilanceDecisionTree? @relation(fields: [vigilanceId], references: [id], onDelete: Cascade)

  @@unique([orgId, complaintId, questionId])
  @@index([orgId, complaintId])
  @@index([vigilanceId])
  @@index([questionId])
}

enum GlobalReportabilityStatus {
  REPORTABLE
  NOT_REPORTABLE
  PENDING_INFORMATION
  REQUIRES_REVIEW
  EXEMPT
  NOT_APPLICABLE
}

model VigilanceJurisdictionAssessment {
  id                  String                    @id @default(cuid())
  orgId               String
  complaintId         String
  vigilanceId         String?
  jurisdiction        String                    // EU, US_FDA, CA_HEALTH_CANADA, AU_TGA, CN_NMPA, JP_PMDA, etc.
  regulator           String
  regulatoryFramework String
  rulesetVersion      String
  status              GlobalReportabilityStatus @default(PENDING_INFORMATION)
  reportingCategory   String?
  reportingReason     String?                   @db.Text

  awarenessDate       DateTime?
  deadline            DateTime?
  deadlineType        String?                   // CALENDAR_DAYS, BUSINESS_DAYS, HOURS
  deadlineDays        Int?
  requiredForm        String?
  submissionMethod    String?

  triggeredRules      Json?                     @default("[]") // Array of rule IDs
  supportingQuestions Json?                     @default("[]") // Array of question IDs
  unresolvedQuestions Json?                     @default("[]") // Array of missing question IDs
  reviewerRequired    Boolean                   @default(false)

  approvedById        String?
  approvedAt          DateTime?
  assessedAt          DateTime                  @default(now())
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id])
  complaint    Complaint              @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  vigilance    VigilanceDecisionTree? @relation(fields: [vigilanceId], references: [id], onDelete: Cascade)

  @@unique([orgId, complaintId, jurisdiction])
  @@index([orgId, complaintId])
  @@index([vigilanceId])
  @@index([jurisdiction])
}

model Attachment {
  id           String   @id @default(cuid())
  orgId        String // Multi-tenant isolation
  complaintId  String?
  fileUrl      String
  fileName     String
  fileSize     Int?
  mimeType     String?
  uploadedById String // Clerk User ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization         Organization           @relation(fields: [orgId], references: [id])
  complaint            Complaint?             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedBy           User?                  @relation(fields: [uploadedById], references: [id])
  investigationId      String?
  investigation        Investigation?         @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  vigilanceId          String?
  vigilance            VigilanceDecisionTree? @relation(fields: [vigilanceId], references: [id], onDelete: Cascade)
  communicationId      String?
  communication        CustomerCommunication? @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  taskId               String?
  task                 ComplaintTask?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  capaId               String?
  capa                 Capa?                  @relation(fields: [capaId], references: [id], onDelete: Cascade)
  capaInitiationId     String?
  capaInitiation       CapaInitiation?        @relation(fields: [capaInitiationId], references: [id], onDelete: Cascade)
  capaInvestigationId  String?
  capaInvestigation    CapaInvestigation?     @relation(fields: [capaInvestigationId], references: [id], onDelete: Cascade)
  capaPlanningId       String?
  capaPlanning         CapaPlanning?          @relation(fields: [capaPlanningId], references: [id], onDelete: Cascade)
  capaImplementationId String?
  capaImplementation   CapaImplementation?    @relation(fields: [capaImplementationId], references: [id], onDelete: Cascade)
  capaEffectivenessId  String?
  capaEffectiveness    CapaEffectiveness?     @relation(fields: [capaEffectivenessId], references: [id], onDelete: Cascade)
  mirId                String?
  mir                  MIR?                   @relation(fields: [mirId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([complaintId])
  @@index([uploadedById])
  @@index([investigationId])
  @@index([vigilanceId])
  @@index([communicationId])
  @@index([taskId])
  @@index([capaId])
  @@index([capaInitiationId])
  @@index([capaInvestigationId])
  @@index([capaPlanningId])
  @@index([capaImplementationId])
  @@index([capaEffectivenessId])
  @@index([mirId])
}

// -------------------------------------------------------------
// Ad-Hoc Complaint Tasks (Sub-workflows)
// -------------------------------------------------------------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum TaskType {
  CORRECTION
  CUSTOMER_FOLLOW_UP
  INTERNAL_FOLLOW_UP
  REGULATORY_TASK
}

enum TaskSubType {
  RISK_REVIEW
  COMPLAINT_HISTORY_REVIEW
  HAZARD_DECISION_INVESTIGATION_FOLLOW_UP
  MANUFACTURING_DEFECT_IDENTIFIED
  COMPLAINT_HISTORY_REVIEW_IDENTIFIED_ISSUE
  DESIGN_ISSUE_DETECTED
  OTHER
}

model ComplaintTask {
  id          String @id @default(cuid())
  orgId       String
  complaintId String

  status      TaskStatus   @default(OPEN)
  taskType    TaskType
  taskSubType TaskSubType? // Conditionally required if taskType is INTERNAL_FOLLOW_UP

  shortDescription String
  taskDescription  String? @db.Text

  dateOfRequest DateTime  @default(now())
  dateDue       DateTime?

  originatorId String // Clerk User ID of the creator
  assignedToId String? // Clerk User ID of the assignee

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [orgId], references: [id])
  complaint    Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  originator   User         @relation("TaskOriginator", fields: [originatorId], references: [id])
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  attachments  Attachment[]

  @@index([orgId])
  @@index([complaintId])
  @@index([assignedToId])
}

// -------------------------------------------------------------
// CAPA Records (Corrective and Preventive Actions)
// -------------------------------------------------------------

enum CapaPhase {
  INITIATION
  INVESTIGATION
  PLANNING
  IMPLEMENTATION
  EFFECTIVENESS
  CLOSED
}

enum CapaType {
  CORRECTIVE
  PREVENTIVE
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Capa {
  id               String    @id @default(cuid())
  orgId            String
  capaNumber       String // e.g., CAPA-2026-0001
  shortDescription String
  type             CapaType  @default(CORRECTIVE)
  currentPhase     CapaPhase @default(INITIATION)

  ownerId String // Clerk User ID

  // CAPA Cancellation
  cancellationRequested     Boolean @default(false)
  cancellationJustification String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 Phase Relations
  initiation     CapaInitiation?
  investigation  CapaInvestigation?
  planning       CapaPlanning?
  implementation CapaImplementation?
  effectiveness  CapaEffectiveness?

  // Relations
  organization      Organization       @relation(fields: [orgId], references: [id])
  owner             User               @relation("CapaOwner", fields: [ownerId], references: [id])
  extensionRequests ExtensionRequest[]
  attachments       Attachment[]
  auditLogs         AuditLog[]

  @@unique([orgId, capaNumber])
  @@index([orgId, currentPhase])
  @@index([ownerId])
}

model ExtensionRequest {
  id     String @id @default(cuid())
  orgId  String
  capaId String

  targetPhase             CapaPhase
  requestedDueDate        DateTime
  justification           String                 @db.Text
  riskEvaluationRationale String?                @db.Text
  status                  ExtensionRequestStatus @default(PENDING)

  requesterId         String
  primaryApproverId   String?
  secondaryApproverId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capa              Capa         @relation(fields: [capaId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [orgId], references: [id])
  requester         User         @relation("ExtensionRequester", fields: [requesterId], references: [id])
  primaryApprover   User?        @relation("ExtensionPrimaryApprover", fields: [primaryApproverId], references: [id])
  secondaryApprover User?        @relation("ExtensionSecondaryApprover", fields: [secondaryApproverId], references: [id])

  @@index([orgId])
  @@index([capaId])
  @@index([primaryApproverId])
}

model CapaInitiation {
  id     String @id @default(cuid())
  orgId  String
  capaId String @unique

  // Core Problem & Containment
  problemStatement  String  @db.Text
  containmentAction String? @db.Text

  // Origin & Tracking
  dateDue                   DateTime?
  source                    String?
  repeatCapa                Boolean   @default(false)
  capaReference             String?
  existingCapa              Boolean   @default(false)
  existingOpenCapaReference String?
  existingCapaDueDate       DateTime?

  // Product & Process Impact
  processOrProduct String?
  affectedArea     String?
  productDetails   String? @db.Text
  relatedProcess   String?

  // Risk Assessment
  severityRanking     String?
  severityRationale   String? @db.Text
  occurrenceRanking   String?
  occurrenceRationale String? @db.Text
  riskCategory        String?

  // Determination
  capaRequired Boolean @default(true)
  capaType     String?
  capaSummary  String? @db.Text

  // Regulatory / FSCA
  fscaRequired  Boolean @default(false)
  fscaRefNumber String?

  // Gate Sign-off & Approvals
  primaryApproverId   String?
  secondaryApproverId String?
  completedById       String?
  completedAt         DateTime?

  // Relations
  capa         Capa         @relation(fields: [capaId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id])

  primaryApprover   User?        @relation("InitiationPrimaryApprover", fields: [primaryApproverId], references: [id])
  secondaryApprover User?        @relation("InitiationSecondaryApprover", fields: [secondaryApproverId], references: [id])
  completedBy       User?        @relation("InitiationSignOff", fields: [completedById], references: [id])
  attachments       Attachment[]

  @@index([orgId])
  @@index([primaryApproverId])
  @@index([secondaryApproverId])
}

model CapaInvestigation {
  id     String @id @default(cuid())
  orgId  String
  capaId String @unique

  containmentSummary   String?  @db.Text
  investigationSummary String?  @db.Text
  rootCauseDescription String?  @db.Text
  rootCauseTools       String[] @default([]) // Multiselect array

  impactProductQuality          Boolean @default(false)
  impactProductQualityRationale String? @db.Text

  planDueDate DateTime?

  // Ownership & Approvals
  investigatorId      String?
  primaryApproverId   String?
  secondaryApproverId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capa         Capa         @relation(fields: [capaId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id])

  investigator      User? @relation("InvestigationInvestigator", fields: [investigatorId], references: [id])
  primaryApprover   User? @relation("InvestigationPrimaryApprover", fields: [primaryApproverId], references: [id])
  secondaryApprover User? @relation("InvestigationSecondaryApprover", fields: [secondaryApproverId], references: [id])

  attachments Attachment[]

  @@index([orgId])
  @@index([investigatorId])
  @@index([primaryApproverId])
}

model CapaPlanning {
  id     String @id @default(cuid())
  orgId  String
  capaId String @unique

  capaPlanDueDate        DateTime?
  actionPlan             String?   @db.Text
  effectivenessCheckPlan String?   @db.Text

  // Approvals
